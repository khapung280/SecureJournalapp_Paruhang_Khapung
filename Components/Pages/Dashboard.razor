@page "/dashboard"
@using SecureJournalapp_Paruhang_Khapung.Models
@using SecureJournalapp_Paruhang_Khapung.Services
@inject JournalDbService JournalService
@inject AuthStateService AuthState
@inject NavigationManager Nav

<div class="dashboard-container">
    <div class="dashboard-header">
        <h1>Dashboard Analytics & Insights</h1>
        <div class="header-actions">
            <button class="btn secondary" @onclick="GoToExport">Export</button>
            <button class="btn secondary" @onclick="GoToEntries">← Back to Entries</button>
        </div>
    </div>

    @if (AllEntries.Any())
    {
        <!-- Mood Analytics Section -->
        <div class="analytics-card">
            <h2>Mood Analytics</h2>
            
            <!-- Mood Distribution by Category -->
            <div class="analytics-subsection">
                <h3>Mood Distribution</h3>
                <div class="mood-distribution">
                    <div class="mood-category positive">
                        <div class="category-label">Positive</div>
                        <div class="category-value">@PositiveMoodCount entry(ies)</div>
                        <div class="category-percentage">@GetPercentage(PositiveMoodCount, TotalEntries)%</div>
                    </div>
                    <div class="mood-category neutral">
                        <div class="category-label">Neutral</div>
                        <div class="category-value">@NeutralMoodCount entry(ies)</div>
                        <div class="category-percentage">@GetPercentage(NeutralMoodCount, TotalEntries)%</div>
                    </div>
                    <div class="mood-category negative">
                        <div class="category-label">Negative</div>
                        <div class="category-value">@NegativeMoodCount entry(ies)</div>
                        <div class="category-percentage">@GetPercentage(NegativeMoodCount, TotalEntries)%</div>
                    </div>
                </div>
            </div>

            <!-- Most Frequent Moods -->
            <div class="analytics-subsection">
                <h3>Most Frequent Primary Moods</h3>
                @if (MostFrequentMoods.Any())
                {
                    <div class="frequent-moods-list">
                        @foreach (var moodStat in MostFrequentMoods)
                        {
                            <div class="frequent-mood-item">
                                <span class="mood-badge @moodStat.Mood.Category.ToLower()">@moodStat.Mood.Name</span>
                                <span class="mood-count">@moodStat.Count @(moodStat.Count == 1 ? "time" : "times")</span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="no-data-hint">No mood data available.</p>
                }
            </div>
        </div>

        <!-- Tag Analytics Section -->
        <div class="analytics-card">
            <h2>Tag Analytics</h2>
            <div class="analytics-subsection">
                <h3>Tag Usage Breakdown</h3>
                @if (TagUsageStats.Any())
                {
                    <div class="tag-breakdown">
                        @foreach (var tagStat in TagUsageStats.OrderByDescending(t => t.Count).Take(10))
                        {
                            <div class="tag-stat-item">
                                <span class="tag-badge @(tagStat.Tag.IsPreBuilt ? "prebuilt" : "custom")">@tagStat.Tag.Name</span>
                                <div class="tag-stat-bar">
                                    <div class="tag-stat-fill" style="width: @GetTagPercentage(tagStat.Count)%"></div>
                                </div>
                                <span class="tag-stat-count">@tagStat.Count @(tagStat.Count == 1 ? "entry" : "entries") (@GetTagPercentage(tagStat.Count)%)</span>
                            </div>
                        }
                    </div>
                    @if (TagUsageStats.Count > 10)
                    {
                        <small class="hint-text">Showing top 10 tags (out of @TagUsageStats.Count total tags)</small>
                    }
                }
                else
                {
                    <p class="no-data-hint">No tags have been used yet.</p>
                }
            </div>
        </div>

        <!-- Writing Analytics Section -->
        <div class="analytics-card">
            <h2>Writing Analytics</h2>
            <div class="analytics-subsection">
                <h3>Word Count Statistics</h3>
                <div class="word-count-stats">
                    <div class="stat-box">
                        <div class="stat-label">Total Words</div>
                        <div class="stat-value">@TotalWordCount.ToString("N0")</div>
                    </div>
                    <div class="stat-box">
                        <div class="stat-label">Average per Entry</div>
                        <div class="stat-value">@AverageWordsPerEntry.ToString("N0")</div>
                    </div>
                    <div class="stat-box">
                        <div class="stat-label">Total Entries</div>
                        <div class="stat-value">@TotalEntries</div>
                    </div>
                </div>
            </div>

            <!-- Word Count Trend Over Time -->
            <div class="analytics-subsection">
                <h3>Word Count Trend (Last 10 Entries)</h3>
                @if (WordCountTrend.Any())
                {
                    <div class="word-trend-list">
                        @foreach (var trendItem in WordCountTrend.Take(10))
                        {
                            <div class="trend-item">
                                <div class="trend-date">@trendItem.Date.ToString("yyyy-MM-dd")</div>
                                <div class="trend-bar-container">
                                    <div class="trend-bar" style="width: @GetTrendPercentage(trendItem.WordCount)%"></div>
                                </div>
                                <div class="trend-value">@trendItem.WordCount words</div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="no-data-hint">No word count data available.</p>
                }
            </div>
        </div>
    }
    else
    {
        <div class="empty-state">
            <h2>No Data Available Yet</h2>
            <p>Start journaling to see your analytics and insights!</p>
            <button class="btn primary" @onclick="GoToJournal">Create Your First Entry</button>
        </div>
    }
</div>

<style>
    .dashboard-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 20px;
    }

    .dashboard-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
        flex-wrap: wrap;
        gap: 12px;
    }

    .dashboard-header h1 {
        margin: 0;
        font-size: 2rem;
        color: #6366f1;
    }

    .layout.dark .dashboard-header h1 {
        color: #818cf8;
    }

    .dashboard-header .header-actions {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }

    .analytics-card {
        background: var(--card-bg, #ffffff);
        border-radius: 12px;
        padding: 24px;
        margin-bottom: 24px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
    }

    .layout.dark .analytics-card {
        background: #1e1e1e;
        box-shadow: 0 2px 8px rgba(255, 255, 255, 0.05);
    }

    .analytics-card h2 {
        margin: 0 0 20px 0;
        font-size: 1.5rem;
        color: #6366f1;
        border-bottom: 2px solid rgba(99, 102, 241, 0.2);
        padding-bottom: 12px;
    }

    .layout.dark .analytics-card h2 {
        color: #818cf8;
        border-bottom-color: rgba(129, 140, 248, 0.3);
    }

    .analytics-subsection {
        margin-bottom: 32px;
    }

    .analytics-subsection:last-child {
        margin-bottom: 0;
    }

    .analytics-subsection h3 {
        margin: 0 0 16px 0;
        font-size: 1.2rem;
        opacity: 0.9;
    }

    /* Mood Distribution */
    .mood-distribution {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 16px;
    }

    .mood-category {
        padding: 20px;
        border-radius: 8px;
        text-align: center;
        transition: transform 0.2s ease;
