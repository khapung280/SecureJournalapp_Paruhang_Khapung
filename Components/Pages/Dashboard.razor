    .mood-category.positive {
        background: rgba(16, 185, 129, 0.1);
        border: 2px solid rgba(16, 185, 129, 0.3);
    }

    .mood-category.neutral {
        background: rgba(156, 163, 175, 0.1);
        border: 2px solid rgba(156, 163, 175, 0.3);
    }

    .mood-category.negative {
        background: rgba(239, 68, 68, 0.1);
        border: 2px solid rgba(239, 68, 68, 0.3);
    }

    .layout.dark .mood-category.positive {
        background: rgba(16, 185, 129, 0.2);
        border-color: rgba(16, 185, 129, 0.4);
    }

    .layout.dark .mood-category.neutral {
        background: rgba(156, 163, 175, 0.2);
        border-color: rgba(156, 163, 175, 0.4);
    }

    .layout.dark .mood-category.negative {
        background: rgba(239, 68, 68, 0.2);
        border-color: rgba(239, 68, 68, 0.4);
    }

    .category-label {
        font-weight: 600;
        font-size: 1.1rem;
        margin-bottom: 8px;
    }

    .category-value {
        font-size: 1.5rem;
        font-weight: 700;
        margin-bottom: 4px;
    }

    .category-percentage {
        font-size: 0.9rem;
        opacity: 0.7;
    }

    .mood-category.positive .category-value {
        color: #10b981;
    }

    .mood-category.neutral .category-value {
        color: #9ca3af;
    }

    .mood-category.negative .category-value {
        color: #ef4444;
    }

    /* Most Frequent Moods */
    .frequent-moods-list {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
    }

    .frequent-mood-item {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 8px 16px;
        background: rgba(99, 102, 241, 0.05);
        border-radius: 8px;
        border: 1px solid rgba(99, 102, 241, 0.2);
    }

    .layout.dark .frequent-mood-item {
        background: rgba(99, 102, 241, 0.1);
        border-color: rgba(99, 102, 241, 0.3);
    }

    .mood-count {
        font-weight: 600;
        opacity: 0.8;
    }

    /* Tag Breakdown */
    .tag-breakdown {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .tag-stat-item {
        display: grid;
        grid-template-columns: 150px 1fr auto;
        gap: 12px;
        align-items: center;
    }

    @@media (max-width: 768px) {
        .tag-stat-item {
            grid-template-columns: 1fr;
            gap: 8px;
        }
    }

    .tag-stat-bar {
        height: 24px;
        background: rgba(99, 102, 241, 0.1);
        border-radius: 4px;
        overflow: hidden;
        position: relative;
    }

    .layout.dark .tag-stat-bar {
        background: rgba(99, 102, 241, 0.2);
    }

    .tag-stat-fill {
        height: 100%;
        background: linear-gradient(90deg, #6366f1, #818cf8);
        transition: width 0.3s ease;
    }

    .tag-stat-count {
        font-weight: 600;
        font-size: 0.9rem;
        white-space: nowrap;
        min-width: 100px;
        text-align: right;
    }

    /* Word Count Stats */
    .word-count-stats {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 16px;
        margin-bottom: 24px;
    }

    .stat-box {
        padding: 20px;
        background: rgba(99, 102, 241, 0.05);
        border-radius: 8px;
        border: 1px solid rgba(99, 102, 241, 0.2);
        text-align: center;
    }

    .layout.dark .stat-box {
        background: rgba(99, 102, 241, 0.1);
        border-color: rgba(99, 102, 241, 0.3);
    }

    .stat-label {
        font-size: 0.9rem;
        opacity: 0.7;
        margin-bottom: 8px;
    }

    .stat-value {
        font-size: 2rem;
        font-weight: 700;
        color: #6366f1;
    }

    .layout.dark .stat-value {
        color: #818cf8;
    }

    /* Word Count Trend */
    .word-trend-list {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .trend-item {
        display: grid;
        grid-template-columns: 120px 1fr auto;
        gap: 12px;
        align-items: center;
    }

    @@media (max-width: 768px) {
        .trend-item {
            grid-template-columns: 1fr;
            gap: 8px;
        }
    }

    .trend-date {
        font-weight: 600;
        font-size: 0.9rem;
        opacity: 0.8;
    }

    .trend-bar-container {
        height: 24px;
        background: rgba(99, 102, 241, 0.1);
        border-radius: 4px;
        overflow: hidden;
        position: relative;
    }

    .layout.dark .trend-bar-container {
        background: rgba(99, 102, 241, 0.2);
    }

    .trend-bar {
        height: 100%;
        background: linear-gradient(90deg, #10b981, #34d399);
        transition: width 0.3s ease;
    }

    .trend-value {
        font-weight: 600;
        font-size: 0.9rem;
        white-space: nowrap;
        min-width: 80px;
        text-align: right;
    }

    .no-data-hint {
        opacity: 0.6;
        font-style: italic;
        margin: 16px 0;
    }

    .hint-text {
        display: block;
        margin-top: 12px;
        opacity: 0.6;
        font-size: 0.85rem;
    }

    .empty-state {
        text-align: center;
        padding: 60px 20px;
        background: var(--card-bg, #ffffff);
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
    }

    .layout.dark .empty-state {
        background: #1e1e1e;
        box-shadow: 0 2px 8px rgba(255, 255, 255, 0.05);
    }

    .empty-state h2 {
        margin: 0 0 12px 0;
        color: #6366f1;
    }

    .empty-state p {
        margin: 0 0 24px 0;
        opacity: 0.7;
    }
</style>

@code {
    private List<JournalEntry> AllEntries { get; set; } = new();
    private Dictionary<int, (Mood? Primary, List<Mood> Secondaries)> EntryMoodsCache { get; set; } = new();
    private Dictionary<int, List<Tag>> EntryTagsCache { get; set; } = new();

    // Mood Analytics
    private int PositiveMoodCount { get; set; }
    private int NeutralMoodCount { get; set; }
    private int NegativeMoodCount { get; set; }
    private List<(Mood Mood, int Count)> MostFrequentMoods { get; set; } = new();

    // Tag Analytics
    private List<(Tag Tag, int Count)> TagUsageStats { get; set; } = new();

    // Word Count Analytics
    private int TotalWordCount { get; set; }
    private double AverageWordsPerEntry { get; set; }
    private List<(DateTime Date, int WordCount)> WordCountTrend { get; set; } = new();

    private int TotalEntries => AllEntries.Count;

    protected override async Task OnInitializedAsync()
    {
        // Check if app is unlocked - redirect to login if not
        if (!AuthState.IsUnlocked)
        {
            Nav.NavigateTo("/login", replace: true);
            return;
        }

        await LoadDashboardDataAsync();
    }

    /// <summary>
    /// DASHBOARD DATA LOADING:
    /// Loads all journal entries and their associated moods and tags, then calculates all analytics.
    /// This method should be called when the dashboard page loads or when entries are created/deleted.
    /// </summary>
    private async Task LoadDashboardDataAsync()
    {
        // Load all entries
        AllEntries = await JournalService.GetAllEntriesAsync();

        if (!AllEntries.Any())
            return;

        // Load moods and tags for all entries
        EntryMoodsCache.Clear();
        EntryTagsCache.Clear();

        foreach (var entry in AllEntries)
        {
            var moods = await JournalService.GetEntryMoodsAsync(entry.EntryId);
            EntryMoodsCache[entry.EntryId] = moods;

            var tags = await JournalService.GetEntryTagsAsync(entry.EntryId);
            EntryTagsCache[entry.EntryId] = tags;
        }

        // Load all moods and tags for mapping
        var allMoods = await JournalService.GetAllMoodsAsync();
        var allTags = await JournalService.GetAllTagsAsync();

        // Calculate all analytics
        CalculateMoodAnalytics(allMoods);
        CalculateTagAnalytics(allTags);
        CalculateWordCountAnalytics();
    }

    /// <summary>
    /// MOOD DISTRIBUTION CALCULATION:
    /// Counts entries by primary mood category (Positive, Neutral, Negative).
    /// Algorithm:
    /// 1. For each entry, get its primary mood
    /// 2. Count entries by mood category
    /// 3. Store counts for Positive, Neutral, and Negative categories
    /// </summary>
    private void CalculateMoodAnalytics(List<Mood> allMoods)
    {
        PositiveMoodCount = 0;
        NeutralMoodCount = 0;
        NegativeMoodCount = 0;
        var moodFrequency = new Dictionary<int, int>();

        foreach (var entry in AllEntries)
        {
            if (EntryMoodsCache.TryGetValue(entry.EntryId, out var moods))
            {
                var primaryMood = moods.Primary;
                if (primaryMood != null)
                {
                    // Count by category
                    switch (primaryMood.Category.ToLower())
                    {
                        case "positive":
                            PositiveMoodCount++;
                            break;
                        case "neutral":
                            NeutralMoodCount++;
                            break;
                        case "negative":
                            NegativeMoodCount++;
                            break;
                    }

                    // Count frequency for most frequent moods
                    if (!moodFrequency.ContainsKey(primaryMood.MoodId))
                        moodFrequency[primaryMood.MoodId] = 0;
                    moodFrequency[primaryMood.MoodId]++;
                }
            }
        }

        // Build most frequent moods list using provided allMoods list
        MostFrequentMoods = moodFrequency
            .Select(kvp => (allMoods.FirstOrDefault(m => m.MoodId == kvp.Key), kvp.Value))
            .Where(x => x.Item1 != null)
            .Select(x => (x.Item1!, x.Value))
            .OrderByDescending(x => x.Value)
            .ThenBy(x => x.Item1.Name)
            .ToList();
    }

    /// <summary>
    /// TAG USAGE CALCULATION:
    /// Counts how many times each tag is used across all entries.
    /// Algorithm:
    /// 1. For each entry, get all its tags
    /// 2. Count how many entries use each tag
    /// 3. Store tag usage statistics (tag name, usage count)
    /// </summary>
    private void CalculateTagAnalytics(List<Tag> allTags)
    {
        var tagUsage = new Dictionary<int, int>();

        foreach (var entry in AllEntries)
        {
            if (EntryTagsCache.TryGetValue(entry.EntryId, out var tags))
            {
                foreach (var tag in tags)
                {
                    if (!tagUsage.ContainsKey(tag.TagId))
                        tagUsage[tag.TagId] = 0;
                    tagUsage[tag.TagId]++;
                }
            }
        }

        // Build tag usage statistics using provided allTags list
        TagUsageStats = tagUsage
            .Select(kvp => (allTags.FirstOrDefault(t => t.TagId == kvp.Key), kvp.Value))
            .Where(x => x.Item1 != null)
            .Select(x => (x.Item1!, x.Value))
            .OrderByDescending(x => x.Value)
            .ThenBy(x => x.Item1.Name)
            .ToList();
    }

    /// <summary>
    /// WORD COUNT CALCULATION:
    /// Calculates word count statistics from entry Content field.
    /// Algorithm:
    /// 1. Split content by whitespace (spaces, newlines, tabs)
    /// 2. Count non-empty words
    /// 3. Calculate total words, average words per entry
    /// 4. Build trend data (word count per entry over time)
    /// 
    /// Example: "Hello world" = 2 words, "I am   happy\nToday" = 4 words
    /// </summary>
    private void CalculateWordCountAnalytics()
    {
        TotalWordCount = 0;
        WordCountTrend.Clear();

        foreach (var entry in AllEntries.OrderBy(e => e.EntryDate))
        {
            // WORD COUNT LOGIC: Split content by whitespace and count non-empty words
            var words = entry.Content
                .Split(new[] { ' ', '\t', '\n', '\r' }, StringSplitOptions.RemoveEmptyEntries)
                .Where(w => !string.IsNullOrWhiteSpace(w))
                .Count();

            TotalWordCount += words;
            WordCountTrend.Add((entry.EntryDate, words));
        }

        AverageWordsPerEntry = AllEntries.Any() ? (double)TotalWordCount / AllEntries.Count : 0;
    }

    private double GetPercentage(int value, int total)
    {
        if (total == 0) return 0;
        return Math.Round((double)value / total * 100, 1);
    }

    private double GetTagPercentage(int count)
    {
        if (!AllEntries.Any()) return 0;
        return Math.Round((double)count / AllEntries.Count * 100, 1);
    }

    private double GetTrendPercentage(int wordCount)
    {
        if (!WordCountTrend.Any()) return 0;
        var maxWords = WordCountTrend.Max(t => t.WordCount);
        if (maxWords == 0) return 0;
        return Math.Min((double)wordCount / maxWords * 100, 100);
    }

    private void GoToEntries() => Nav.NavigateTo("/entries");
    private void GoToJournal() => Nav.NavigateTo("/journal");
    private void GoToExport() => Nav.NavigateTo("/export");
}