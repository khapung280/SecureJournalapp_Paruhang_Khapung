@page "/export"
@using SecureJournalapp_Paruhang_Khapung.Models
@using SecureJournalapp_Paruhang_Khapung.Services
@inject JournalDbService JournalService
@inject PdfExportService PdfExportService
@inject AuthStateService AuthState
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="export-container">
    <div class="export-header">
        <h1>Export Journal Entries</h1>
        <button class="btn secondary" @onclick="GoToEntries">← Back to Entries</button>
    </div>

    <div class="export-card">
        <h2>Select Date Range</h2>
        <p class="export-description">Choose a date range to export your journal entries as a PDF file.</p>

        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="error-message">@ErrorMessage</div>
        }

        @if (!string.IsNullOrEmpty(SuccessMessage))
        {
            <div class="success-message">@SuccessMessage</div>
        }

        <div class="export-form">
            <!-- Date Range Selection -->
            <div class="form-group">
                <label>From Date *</label>
                <input type="date" @bind="StartDate" @bind:format="yyyy-MM-dd" @bind:event="onchange" 
                       @bind:after="OnDateChanged" class="form-control" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                <small class="form-hint">Select the start date (cannot be in the future)</small>
            </div>

            <div class="form-group">
                <label>To Date *</label>
                <input type="date" @bind="EndDate" @bind:format="yyyy-MM-dd" @bind:event="onchange" 
                       @bind:after="OnDateChanged" class="form-control" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                <small class="form-hint">Select the end date (cannot be in the future)</small>
            </div>

            <!-- Validation Message -->
            @if (!IsDateRangeValid)
            {
                <div class="validation-message">
                    Start date must be before or equal to end date.
                </div>
            }

            <!-- Entries Count Preview -->
            @if (IsDateRangeValid && StartDate.HasValue && EndDate.HasValue)
            {
                <div class="entries-preview">
                    <strong>Preview:</strong> @FilteredEntriesCount entry(ies) will be exported
                    @if (FilteredEntriesCount == 0)
                    {
                        <div class="no-entries-warning">
                            No journal entries found for the selected date range.
                        </div>
                    }
                </div>
            }

            <!-- Export Button -->
            <div class="export-actions">
                <button class="btn primary" @onclick="ExportToPdf" disabled="@(!CanExport)">
                    Export as PDF
                </button>
            </div>
        </div>
    </div>

    <!-- Export Instructions -->
    <div class="export-info-card">
        <h3>Export Information</h3>
        <ul>
            <li>Exported PDF will include all entries within the selected date range</li>
            <li>Entries are ordered chronologically (oldest first)</li>
            <li>Each entry includes: date, title, content, moods, and tags</li>
            <li>PDF file will be saved to your Downloads folder (Windows)</li>
            <li>File name format: <code>SecureJournal_Entries_YYYY-MM-DD_to_YYYY-MM-DD.pdf</code></li>
        </ul>
    </div>
</div>

