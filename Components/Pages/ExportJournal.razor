@code {
    private DateTime? StartDate { get; set; }
    private DateTime? EndDate { get; set; }
    private string? ErrorMessage { get; set; }
    private string? SuccessMessage { get; set; }
    private int FilteredEntriesCount { get; set; }

    /// <summary>
    /// DATE RANGE VALIDATION:
    /// Validates that the selected date range is valid for export.
    /// Rules:
    /// - Start date must be before or equal to end date
    /// - Both dates must be selected
    /// - Dates cannot be in the future
    /// </summary>
    private bool IsDateRangeValid
    {
        get
        {
            if (!StartDate.HasValue || !EndDate.HasValue)
                return false;

            // Start date must be <= end date
            if (StartDate.Value.Date > EndDate.Value.Date)
                return false;

            // Dates cannot be in the future
            var today = DateTime.Today;
            if (StartDate.Value.Date > today || EndDate.Value.Date > today)
                return false;

            return true;
        }
    }

    /// <summary>
    /// EXPORT BUTTON STATE:
    /// Determines if the export button should be enabled.
    /// Enabled only when:
    /// - Date range is valid
    /// - At least one entry exists in the selected range
    /// </summary>
    private bool CanExport => IsDateRangeValid && FilteredEntriesCount > 0;

    protected override async Task OnInitializedAsync()
    {
        // Check if app is unlocked - redirect to login if not
        if (!AuthState.IsUnlocked)
        {
            Nav.NavigateTo("/login", replace: true);
            return;
        }

        // Set default date range (last 30 days)
        EndDate = DateTime.Today;
        StartDate = DateTime.Today.AddDays(-30);

        await UpdateEntriesCount();
    }

    /// <summary>
    /// DATE RANGE FILTERING:
    /// Updates the count of entries that will be exported based on the selected date range.
    /// This provides real-time feedback to the user about how many entries will be included.
    /// </summary>
    private async Task UpdateEntriesCount()
    {
        if (!IsDateRangeValid || !StartDate.HasValue || !EndDate.HasValue)
        {
            FilteredEntriesCount = 0;
            return;
        }

        try
        {
            // Fetch entries within the date range
            var entries = await JournalService.SearchEntriesAsync(
                startDate: StartDate.Value,
                endDate: EndDate.Value
            );

            FilteredEntriesCount = entries.Count;
        }
        catch
        {
            FilteredEntriesCount = 0;
        }
    }

    private async Task OnDateChanged()
    {
        ErrorMessage = null;
        SuccessMessage = null;
        await UpdateEntriesCount();
        StateHasChanged();
    }

    /// <summary>
    /// PDF EXPORT PROCESS:
    /// Exports journal entries to PDF file.
    /// 
    /// Algorithm:
    /// 1. Validate date range
    /// 2. Fetch entries within date range from database
    /// 3. Load moods and tags for each entry
    /// 4. Generate PDF using PdfExportService
    /// 5. Save PDF file to Downloads folder (Windows)
    /// 6. Show success message
    /// 
    /// FILE SAVING PROCESS:
    /// - Generate filename: SecureJournal_Entries_YYYY-MM-DD_to_YYYY-MM-DD.pdf
    /// - Save to user's Downloads folder
    /// - Use MAUI FileSystem APIs for cross-platform file access
    /// </summary>
    private async Task ExportToPdf()
    {
        ErrorMessage = null;
        SuccessMessage = null;

        try
        {
            // Validate date range
            if (!IsDateRangeValid || !StartDate.HasValue || !EndDate.HasValue)
            {
                ErrorMessage = "Please select a valid date range.";
                return;
            }

            // Fetch entries within date range
            // DATE RANGE FILTERING: Get entries ordered by date (oldest first)
            var entries = await JournalService.SearchEntriesAsync(
                startDate: StartDate.Value,
                endDate: EndDate.Value
            );

            if (!entries.Any())
            {
                ErrorMessage = "No journal entries found for the selected date range.";
                return;
            }

            // Load moods and tags for all entries
            var entryMoods = new Dictionary<int, (Mood? Primary, List<Mood> Secondaries)>();
            var entryTags = new Dictionary<int, List<Tag>>();

            foreach (var entry in entries)
            {
                var moods = await JournalService.GetEntryMoodsAsync(entry.EntryId);
                entryMoods[entry.EntryId] = moods;

                var tags = await JournalService.GetEntryTagsAsync(entry.EntryId);
                entryTags[entry.EntryId] = tags;
            }

            // Generate PDF
            var pdfBytes = PdfExportService.GeneratePdf(
                entries,
                entryMoods,
                entryTags,
                StartDate.Value,
                EndDate.Value
            );

            // FILE SAVING PROCESS: Save PDF to Downloads folder
            // Generate filename: SecureJournal_Entries_YYYY-MM-DD_to_YYYY-MM-DD.pdf
            var fileName = $"SecureJournal_Entries_{StartDate.Value:yyyy-MM-dd}_to_{EndDate.Value:yyyy-MM-dd}.pdf";
            
            // For Windows MAUI, save to Downloads folder
            var downloadsPath = Path.Combine(
                Environment.GetFolderPath(Environment.SpecialFolder.UserProfile),
                "Downloads"
            );

            // Ensure Downloads folder exists
            if (!Directory.Exists(downloadsPath))
            {
                Directory.CreateDirectory(downloadsPath);
            }

            var filePath = Path.Combine(downloadsPath, fileName);

            // Write PDF bytes to file
            await File.WriteAllBytesAsync(filePath, pdfBytes);

            // Show success message with file path
            SuccessMessage = $"Journal entries exported successfully! File saved to: {filePath}";

            // Optionally open the file location or file
            try
            {
                // On Windows, we can try to open the file location
                if (OperatingSystem.IsWindows())
                {
                    System.Diagnostics.Process.Start("explorer.exe", $"/select,\"{filePath}\"");
                }
            }
            catch
            {
                // Ignore if we can't open file explorer
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error exporting journal entries: {ex.Message}";
        }
    }

    private void GoToEntries() => Nav.NavigateTo("/entries");
}